# ============================================================
# EC2 Monitoring System — Backend Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit .env or *.pem files to version control.
# ============================================================

APP_ENV=development

# ---- Database (Supabase PostgreSQL) ----
DATABASE_URL=postgresql+asyncpg://postgres:YOUR_PASSWORD@db.YOUR_PROJECT_REF.supabase.co:5432/postgres
SUPABASE_SCHEMA=ec2_monitoring_working

# ---- Remote EC2 SSH Configuration ----
EC2_HOST=ec2-xx-xxx-xxx-xxx.ap-south-1.compute.amazonaws.com
EC2_PORT=22
EC2_USERNAME=ubuntu
EC2_PRIVATE_KEY_PATH=ec2-monitoring-key.pem

SSH_CONNECT_TIMEOUT_SECONDS=10
SSH_COMMAND_TIMEOUT_SECONDS=25
COLLECTION_INTERVAL_SECONDS=15

# ---- Anomaly Detection Thresholds ----
CPU_WARNING_THRESHOLD=70
CPU_CRITICAL_THRESHOLD=90

MEMORY_WARNING_THRESHOLD=75
MEMORY_CRITICAL_THRESHOLD=90

DISK_WARNING_THRESHOLD=80
DISK_CRITICAL_THRESHOLD=90

CORRELATION_WINDOW_MINUTES=5
ANOMALY_CONSECUTIVE_SAMPLES=3

# ---- Optional Application Response Time ----
MONITORED_URL=
RESPONSE_TIME_WARNING_MS=1000
RESPONSE_TIME_CRITICAL_MS=2000

# ---- Groq LLM (Optional - system falls back to rule engine if missing) ----
GROQ_API_KEY=
GROQ_MODEL=qwen/qwen3.8-27b

# ---- CORS ----
CORS_ORIGINS=http://localhost:5173

# ---- Security ----
MONITORING_AGENT_API_KEY=CHANGE_ME_RANDOM_SECRET_32_CHARS
