# ============================================================
# EC2 Monitoring Agent — Environment Variables
# Copy this file to .env and fill in your values.
# Run this agent ON the EC2 Linux instance.
# ============================================================

# ---- Backend Connection ----
BACKEND_URL=http://YOUR_BACKEND_HOST:8000

# ---- Authentication ----
# Must match MONITORING_AGENT_API_KEY in the backend .env
MONITORING_AGENT_API_KEY=CHANGE_ME_RANDOM_SECRET_32_CHARS

# ---- Collection Interval ----
# How often (in seconds) metrics are collected and sent
COLLECTION_INTERVAL_SECONDS=30

# ---- Optional: Application Health URL ----
# If the EC2 instance hosts an HTTP service, set this to measure response time.
# Leave blank to disable response-time monitoring.
MONITORED_URL=

# ---- HTTP Request Timeout (seconds) ----
REQUEST_TIMEOUT_SECONDS=10

# ---- Retry Settings ----
MAX_RETRIES=3
RETRY_WAIT_SECONDS=5

# ---- Logging ----
LOG_LEVEL=INFO
